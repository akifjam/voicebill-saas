# Server port (Render / Railway set this automatically)
PORT=3000

# Optional persistent volume directory (e.g. /data on Railway or Render Disk)
# Leave blank to use ./data locally
DATA_DIR=

# Global Checkout Link ($19/mo via Dodo Payments, Lemon Squeezy, Polar, or Stripe Payment Link)
# Set post-payment redirect URL to: https://YOUR-APP-URL.com/?upgraded=1
PRO_STRIPE_LINK=

# India Checkout Link (₹699/mo via Razorpay Payment Page / Subscription Link)
# Set post-payment redirect URL to: https://YOUR-APP-URL.com/?upgraded=1
PRO_RAZORPAY_LINK=

# Optional Pro Activation Code
PRO_ACTIVATION_CODE=
